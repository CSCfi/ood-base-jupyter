# Batch Connect app configuration file
#
# @note Used to define the submitted cluster, title, description, and
#   hard-coded/user-defined attributes that make up this Batch Connect app.
---

# **MUST** set cluster id here that matches cluster configuration file located
# under /etc/ood/config/clusters.d/*.yml
# @example Use the Owens cluster at Ohio Supercomputer Center
#     cluster: "owens"

# Define attribute values that aren't meant to be modified by the user within
# the Dashboard form
form_header: |
  <a href="https://docs.lumi-supercomputer.eu/runjobs/webui/jupyter/" target="_blank">Documentation</a>
attributes:
  # Set the corresponding modules that need to be loaded for Jupyter to run
  #
  # @note It is called within the batch job as `module load <modules>` if
  #   defined
  # @example Do not load any modules
  #     modules: ""
  # @example Using default python module
  #     modules: "python"
  # @example Using specific python module
  #     modules: "python/3.5"
  # @example Using combination of modules
  #     modules: "python/3.5 cuda/8.0.44"
  #modules: "python-env/2019.3"
  #bc_queue: "test" 

  # Any extra command line arguments to feed to the `jupyter notebook ...`
  # command that launches the Jupyter notebook within the batch job

  csc_slurm_partition:
    value: "interactive"
    select:
      - "interactive"
      - "small"
      - "small-g"
      - "largemem"
      - "lumid"
      - "dev-g"
      - "debug"
      - "q_fiqci"
      - "q_industry"
  python_module:
      label: Python
      widget: select
      options:
          - ["cray-python (3.10.10)", "cray-python/3.10.10",data-hide-custom-python-path: true]
          - ["cray-python (3.9.13)", "cray-python/3.9.13.1", data-hide-custom-python-path: true]
          - ["geoconda ( Via CSC stack, limited support available )", "geoconda", data-hide-custom-python-path: true]
          - ["pytorch ( Via CSC stack, limited support available )", "pytorch", data-hide-custom-python-path: true]
          - ["Custom", "custom"]
      wrapper:
        class: "basic"
  custom_python_path:
    widget: text_field
    label: "Path to python"
    value : ""
    wrapper:
      class: "basic custom_module"
    help: |
        Specify the full path to the python interpreter to use
  jp_type: "lab"
  csc_path:
    submit: notebook_dir
    label: "Working directory"
    paths:
      - "HOME"
      - "SCRATCH"
      - "PROJAPPL"
      - "/"
  advanced:
    label: "Show advanced settings"
    widget: check_box
    value: "0"
    hidden: true
    skip_label: true
  enable_venv:
    label: "Enable virtual environment"
    widget: check_box
    value: "0"
    wrapper_class: "venv"
    html_options:
      data:
        hide-venv-when-un-checked: true
        hide-system-site-when-un-checked: true
        hide-user-packages-when-un-checked: true
  venv:
    widget: text_field
    label: "Virtual environment path"
    value : ""
    wrapper:
      class: "venv"
    help: |
      Path to a virtual environment under `/scratch/$PROJECT` or `/projappl/$PROJECT`. A new virtual environment will be created using `python -m venv <path>` if it does not exist. No virtual environment will be used if left empty.
  system_site:
      label: "Enable system installed packages on venv creation"
      widget: check_box
      value: "1"
      wrapper_class: "venv"
  user_packages:
      label: "Enable packages under ~/.local/lib on venv start"
      widget: check_box
      value: "0"
      wrapper_class: "venv"
  custom_type:
    label: "Custom Python type"
    widget: select
    wrapper:
      class: "advanced"
    options:
        - ["Script", "script", { data-hide-custom-script: false, data-hide-container-path: true, data-hide-container-modules: true, data-hide-container-init: true, data-hide-container-args: true}]
        - ["Container", "container", { data-hide-custom-start: true, data-hide-custom-script: true }]
  custom_script:
      label: "Script or path to script"
      widget: "text_area"
      value: ""
      wrapper:
         class: "advanced"
      help: |
        The provided script will be run before starting Jupyter. If a path to a script is provided, it will be sourced by bash before starting Jupyter. Ensure that the script sets up the environment so that `python` is in `PATH` and Jupyter is installed.
  container_modules:
    label: "Modules to load"
    widget: "text_field"
    value: ""
    wrapper_class: "advanced"
    help: |
      Specify modules to load, separated with spaces, e.g. `LUMI/23.09 PyTorch/2.2.0`.
  container_args:
    label: "Container arguments"
    widget: "text_field"
    value: ""
    wrapper_class: "advanced"
    help: |
      Extra Singularity arguments, e.g. `-B /some/path:/some/other/path`
  container_path:
      label: "Path to container with Python"
      widget: "text_field"
      value: ""
      wrapper:
         class: "advanced"
      help: |
        Jupyter will be launched using the Python from the specified container, using `singularity exec -B ... <container.sif> python3 -m jupyter ...`.  
        The following paths will be mounted in to the container: `/pfs`, `/users`, `/scratch`, `/projappl`, `/project`, `/flash`, and `/appl`.  
        If `jupyterlab` is not installed in the Python environment, ensure that you specify a virtual environment path below, which will be used to install Jupyterlab.
  container_init:
    label: "Init script for container"
    widget: "text_field"
    value: ""
    wrapper:
      class: "advanced"
    help: |
      Commands to run inside the container before Python is run. Can be used for activating the container conda environment, e.g. `source /opt/miniconda3/bin/activate pytorch`.

  csc_reset_cache:
    app: "sys/ood-base-jupyter"

form:
  - csc_slurm_reservation
  - csc_slurm_project
  - csc_slurm_partition
  - csc_header_resources
  - csc_cores
  - csc_memory
  - csc_nvme
  - csc_gpu
  - csc_time
  - csc_header_settings
  - jp_type
  - csc_path
  - advanced
  - python_module
  - custom_type
  - custom_script
  - custom_python_path
  - container_modules
  - container_path
  - container_args
  - container_init
  - enable_venv
  - venv
  - system_site
  - user_packages
  - csc_reset_cache
  - csc_slurm_limits

#!/usr/bin/env bash

# Prints $1 in log and app info card before cancelling slurm job and exiting with exit code $2.
exit_verbose() {
  echo "$1" | tee "<%= session.staged_root.join("job_exit_reason") -%>"
  scancel "$SLURM_JOB_ID"
  exit "${2:-0}"
}

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"

<% if context.advanced == "1" %>
  <% if context.custom_type == "script" %>
    <% custom_script = context.custom_script.gsub(/\r\n?/, "\n") %>
    if [ -f "$custom_script" ]; then
      echo "Sourcing $custom_script"
      source "<%= custom_script %>"
    else
      echo "Running user-provided script"
      <%= custom_script %>
    fi
  <% elsif context.custom_type == "container" %>
    module load <%= context.container_modules %>
    container_init='<%= context.container_init -%>'
    <% if !context.container_path.strip.empty? %>
      container_command='singularity exec -B /pfs,/users,/scratch,/projappl,/project,/flash,/appl '"<%= context.container_args -%>"' '"<%= context.container_path -%>"
      python () {
        $container_command bash -c "$container_init${container_init:+;} python3 $(printf "%q " "$@")"
      }
    <% end %>
    echo "Using python from container, container_command: $container_command"
  <% end %>
<% end %>

python="${python:-python}"
<% if context.advanced == "0" || (context.advanced == "1" && context.custom_type == "container") %>
  <% if context.python_module == "custom" -%>
    echo 'Custom python interpreter path set: <%= context.custom_python_path %>'
    python_path="<%= context.custom_python_path %>"
    if [[ -f "$python_path" && -x "$python_path" ]]; then
      echo "Custom python is an executable file"
      # User provided full path to python executable
      python="$python_path"
      export PATH="$(dirname "$python_path"):$PATH"
    elif [[ -d $python_path && "$(basename "$python_path")" = "bin" ]]; then
      echo "Custom python is a bin directory with python"
      # User provided a path to a bin directory with a python executable
      export PATH="$python_path:$PATH"
      if [[ "$(dirname "$(command -v python)")" = "${python_path%%/}" ]]; then
        python="$(command -v python)"
      else
        # User provided a bin path but no python was found
        # TODO: allow python3 binary instead of just python?
        exit_verbose "Python not found in provided path: $python_path" 1
      fi
    else
      # User provided something that wasn't either a path to python binary or bin directory
      # TODO: attempt to load module here?
      exit_verbose "Unknown python path provided" 1
    fi
  <% elsif context.advanced == "0" %>
    <% if context.python_module =~ /base-py/ or context.python_module =~ /pytorch/ or context.python_module =~ /geoconda/ -%>
      echo "CSC Python module selected, enabling CSC stack"
      ml use /appl/local/csc/modulefiles/
    <% end %>
      module load <%= context.python_module %>
      # If there is no venv set and cray python selected add a minimal set of packages
      # containing the notebook software. 
      <% if context.python_module =~ /cray-python/ -%>
        <% if context.enable_venv == "0" || context.venv == "" -%>
          _PY_VER="<%= context.python_module.split('/',2)[1].split('.',3).slice(0,2).join('.') -%>"
          export PYTHONPATH=$PYTHONPATH:/appl/local/ood/$SLURM_OOD_ENV/soft/base_py/$_PY_VER/
          export PATH=$PATH:/appl/local/ood/$SLURM_OOD_ENV/soft/base_py/$_PY_VER/bin/
          export JUPYTERLAB_DIR=/appl/local/ood/$SLURM_OOD_ENV/soft/base_py/$_PY_VER/share/jupyter/lab/
        <% end %>
      <% end %>
  <% end %>

  # List loaded modules
  module list

  venv="<%= context.venv -%>"
  venv="${venv%/bin/activate}"
  if [[ '<%= context.enable_venv -%>' == "1" && ! -z "$venv" ]]; then
    if [[ -f "$venv/bin/activate" ]]; then
      echo "Activating venv at $venv"
      if [ ! -z "${container_command+x}" ]; then
        python () {
          $container_command bash -c "$container_init${container_init:+;} source \"$venv/bin/activate\"; python3 $(printf "%q " "$@")"
        }
      else
        source "$venv/bin/activate"
        python=${python:-python}
      fi
    else
      echo "Creating new venv at $venv"
      # --system-site-packages does not work properly with the module system
      # packages from the module are added if module is loaded when activating venv
      error_msg=$($python -m venv "$venv" <%= "--system-site-packages" if context.system_site == "1" -%> 2>&1 > /dev/null)
      return_code="$?"
      if [[ ! "$return_code" -eq 0 ]];then
        exit_verbose "Could not create venv: $error_msg" 1
      fi

      echo "Activating created venv at $venv"

      if [ ! -z "${container_command+x}" ]; then
        python () {
          $container_command bash -c "$container_init${container_init:+;} source \"$venv/bin/activate\"; python3 $(printf "%q " "$@")"
        }
      else
        source "$venv/bin/activate"
        python=${python:-python}
      fi

      # Set PYTHONNOUSERSITE already to avoid accidentally installing into user packages if venv is not writable.
      <% if context.user_packages == "0" -%>
      export PYTHONNOUSERSITE="TRUE"
      <% end -%>

      # Install jupyterlab if there is no jupyter installed (system python only)
      if [[ ! $(command -v jupyter) && -z "${container_command+x}" ]] || [[ ! -z "${container_command+x}" && ! $(${python:-python} -m jupyterlab --help) ]]; then
        echo "Installing jupyterlab"
        ${python:-python} -m pip install jupyterlab nbclassic
      fi

    fi

    # Install kernel that points to the venv python
    ${python:-python} -m ipykernel install --prefix="<%= context.venv -%>" --name="python3" --display-name="Python 3 (venv)"

    # Set JUPYTER_DATA_DIR to find kernels from this venv
    export JUPYTER_DATA_DIR="$venv/share/jupyter"
    <% if context.user_packages == "0" -%>
      echo "Disabling user packages"
      export PYTHONNOUSERSITE="TRUE"
      if ! $(PYTHONNOUSERSITE="TRUE" python -c 'import jupyter' > /dev/null 2>&1); then
        if $(unset PYTHONNOUSERSITE; python -c 'import jupyter' > /dev/null 2>&1); then
          echo "Jupyter is installed only in user packages but user packages are disabled"
        else
          echo "Jupyter is not installed"
        fi
      fi
    <% end -%>
  fi
<% end %>


jp_type="lab"

${python:-python} -m jupyter server extension enable --user --py nbclassic
${python:-python} -m jupyter server extension enable --user --py jupyterlab

# Benchmark info
echo "TIMING - Starting jupyter at: $(date)"
# Launch the Jupyter Notebook Server
set -x
${python:-python} -m jupyter $jp_type --config="${CONFIG_FILE}"
